# ==============================================================================
# UNSEEN — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Railway / Local)
# ------------------------------------------------------------------------------
# Host & Port: Railway automatically injects $PORT. Local default is 8000.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# SQLite Database Location:
# - Local default: backend/unseen.db
# - Railway Volume Mount: /app/data/unseen.db
DATABASE_PATH=/app/data/unseen.db
# Or alternatively via database URL format:
# DATABASE_URL=sqlite:////app/data/unseen.db

# CORS Allowed Origins:
# Comma-separated list of allowed frontend domains.
# NOTE: Vercel preview and production domains (*.vercel.app) are automatically allowed by regex.
CORS_ORIGINS=https://unseen-network-intelligence.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Local)
# ------------------------------------------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables
# Points to your deployed Railway backend URL (no trailing slash required).
VITE_API_URL=https://unseen-backend-production.up.railway.app
VITE_APP_TITLE=UNSEEN - Network Intelligence
VITE_APP_DESCRIPTION=Multi-agent network intelligence and fault investigation platform

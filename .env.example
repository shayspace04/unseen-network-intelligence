# ==============================================================================
# UNSEEN — Agentic AI Network Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# SQLite Database Path (Defaults to local backend/unseen.db if unset)
DATABASE_URL=sqlite:///./unseen.db

# Frontend Configuration (Used by Vite dev server and production builds)
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=UNSEEN - Network Intelligence
VITE_APP_DESCRIPTION=Multi-agent network intelligence and fault investigation platform
